{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "thornwake"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "rooms": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "spawn": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 79,
                "multipleOf": 0.5
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 43,
                "multipleOf": 0.5
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "deathRule": {
            "type": "string",
            "enum": [
              "instant",
              "health"
            ]
          },
          "abilities": {
            "type": "object",
            "properties": {
              "dash": {
                "type": "boolean"
              },
              "doubleJump": {
                "type": "boolean"
              },
              "wallJump": {
                "type": "boolean"
              },
              "pogo": {
                "type": "boolean"
              },
              "longDash": {
                "type": "boolean"
              },
              "grapple": {
                "type": "boolean"
              },
              "swing": {
                "type": "boolean"
              }
            },
            "required": [
              "dash",
              "doubleJump",
              "wallJump",
              "pogo",
              "longDash",
              "grapple",
              "swing"
            ],
            "additionalProperties": false
          },
          "objects": {
            "maxItems": 2500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 79,
                  "multipleOf": 0.5
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 43,
                  "multipleOf": 0.5
                },
                "id": {
                  "type": "string",
                  "maxLength": 80
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "solid",
                    "spike",
                    "pogo",
                    "enemy",
                    "crystal",
                    "checkpoint",
                    "exit",
                    "anchor",
                    "moving",
                    "timed",
                    "switch",
                    "door",
                    "gravity",
                    "pad"
                  ]
                },
                "w": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 80,
                  "multipleOf": 0.5
                },
                "h": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 44,
                  "multipleOf": 0.5
                },
                "axis": {
                  "default": "x",
                  "type": "string",
                  "enum": [
                    "x",
                    "y"
                  ]
                },
                "travel": {
                  "default": 4,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "speed": {
                  "default": 70,
                  "type": "number",
                  "minimum": 10,
                  "maximum": 300
                },
                "period": {
                  "default": 2.5,
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 12
                },
                "phase": {
                  "default": 0,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 12
                },
                "channel": {
                  "default": "A",
                  "type": "string",
                  "maxLength": 30
                },
                "target": {
                  "default": "next",
                  "type": "string",
                  "maxLength": 80
                },
                "anchorMode": {
                  "default": "pull",
                  "type": "string",
                  "enum": [
                    "pull",
                    "swing"
                  ]
                },
                "switchMode": {
                  "default": "toggle",
                  "type": "string",
                  "enum": [
                    "toggle",
                    "hold"
                  ]
                },
                "direction": {
                  "default": "up",
                  "type": "string",
                  "enum": [
                    "up",
                    "down",
                    "left",
                    "right"
                  ]
                }
              },
              "required": [
                "x",
                "y",
                "id",
                "kind",
                "w",
                "h",
                "axis",
                "travel",
                "speed",
                "period",
                "phase",
                "channel",
                "target",
                "anchorMode",
                "switchMode",
                "direction"
              ],
              "additionalProperties": false
            }
          },
          "theme": {
            "default": "palace",
            "type": "string",
            "enum": [
              "palace",
              "garden",
              "furnace"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "spawn",
          "deathRule",
          "abilities",
          "objects",
          "theme"
        ],
        "additionalProperties": false
      }
    },
    "clears": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "maxLength": 80
          },
          "physicsVersion": {
            "type": "string",
            "maxLength": 30
          },
          "roomHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "inputs": {
            "maxItems": 150000,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": [
          "roomId",
          "physicsVersion",
          "roomHash",
          "inputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "name",
    "rooms",
    "clears"
  ],
  "additionalProperties": false
}
